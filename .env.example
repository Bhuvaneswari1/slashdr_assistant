# Shareable template only. Keep your actual key in .env or cloud environment settings.
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4.1-mini
PORT=8000
# Optional for localhost. Required by api.py on Render; set both to enable review login.
# REVIEW_USERNAME=client-review
# REVIEW_PASSWORD=replace-with-a-long-unique-password

# Data source: synthetic is the default for cloud/client-review deployments.
DATA_MODE=synthetic
# Local CSV integration. The actual database is excluded from source control.
# CSV_DATABASE=/absolute/path/to/private_data/slashdr.sqlite
# CSV_ALLOWED_CLINICS=10,20
# Use * only for trusted local review with the Clinic ID input.
ALLOW_EXTERNAL_PATIENT_DATA=false
